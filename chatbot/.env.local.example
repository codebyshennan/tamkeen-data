# Copy to .env.local for local dev with `vercel dev`. Real values live in
# Vercel's project env settings (set via `vercel env add ...`) — never
# commit a real key here. .env.local is gitignored.

OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Optional overrides
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_REFERRER=https://codebyshennan.github.io/dsai
